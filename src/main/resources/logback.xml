<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <target>System.out</target>
        <encoder pattern="[%thread] %-5level %logger{36} - %msg%n" />
    </appender>

    <logger name="com.dtmetrics" level="DEBUG" />
    <root level="INFO">
        <appender-ref ref="CONSOLE" />
    </root>
</configuration>
